{
  "name": "zeni",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "simulate": "tsx tools/simulate.ts",
    "ai-match": "tsx tools/ai-match.ts",
    "icons": "tsx tools/make-icons.ts",
    "play-online": "tsx tools/play-online.ts",
    "bot-room": "tsx tools/bot-room.ts",
    "play-quick": "tsx tools/play-quick.ts",
    "play-challenge": "tsx tools/play-challenge.ts",
    "report": "tsx tools/report.ts",
    "share-image": "tsx tools/make-share-image.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/node": "^26.6.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
