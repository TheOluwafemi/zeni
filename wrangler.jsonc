{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeni",
  "compatibility_date": "2026-10-03",
  "main": "./server/worker.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    // API and WebSocket routes go to the Worker; everything else is the static client.
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // Player accounts and (later) match results. `wrangler dev` uses a local copy of this database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeni",
      "database_id": "6d10485e-0abc-4587-ae61-b7a92bb40cf5",
      "migrations_dir": "migrations"
    }
  ],
  // A Durable Object per game room (holds both players' sockets and plays every shot), plus the Quick Match queue.
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" },
    // The Quick Match queue, one per table. Its state lives in its sockets, but the class still needs a backend.
    "Matchmaker": { "type": "durable-object", "storage": "sqlite" },
    // "Who's around": in-memory counts only, nothing stored.
    "Presence": { "type": "durable-object", "storage": "sqlite" }
  },
  // A daily cleanup of short-lived records (see server/maintenance.ts), at 03:17 UTC.
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  // Per-address limits, counted at each Cloudflare location: API calls, new WebSockets, presence pings.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SOCKET_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "PRESENCE_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    // Keep our own error logs, but not a log of every request: those would hold visitors' internet
    // addresses for days, and the privacy page promises addresses are only used for rate limits.
    "logs": { "invocation_logs": false }
  },
  // Staging: a separate Worker (zeni-staging) and database, for trying v2 before it reaches players.
  // Build it with CLOUDFLARE_ENV=staging (npm run deploy:staging). Bindings are repeated here because
  // environments don't inherit them.
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zeni-staging",
          "database_id": "d2f7c007-b971-4e49-8519-a534928031c4",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" },
          { "name": "PRESENCE", "class_name": "Presence" }
        ]
      },
      "exports": {
        "Room": { "type": "durable-object", "storage": "sqlite" },
        "Matchmaker": { "type": "durable-object", "storage": "sqlite" },
        "Presence": { "type": "durable-object", "storage": "sqlite" }
      },
      "triggers": {
        "crons": ["17 3 * * *"]
      },
      "ratelimits": [
        { "name": "API_LIMIT", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
        { "name": "SOCKET_LIMIT", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
        { "name": "PRESENCE_LIMIT", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
      ],
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false }
      }
    }
  }
}
